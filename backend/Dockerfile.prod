FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf

WORKDIR /app

# CPU-only PyTorch (the default wheel bundles ~2 GB of GPU libraries we don't need).
RUN pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt

# Run as a normal user, not root: a bug in the app can't rewrite the system.
RUN useradd --create-home --uid 10001 app \
    && mkdir -p /data/uploads /data/hf /data/eval \
    && chown -R app:app /data /app
COPY --chown=app:app . .
USER app

EXPOSE 8000
# --proxy-headers: trust X-Forwarded-For from nginx so rate limits see real client IPs.
# The backend is never published directly, only nginx can reach it.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
